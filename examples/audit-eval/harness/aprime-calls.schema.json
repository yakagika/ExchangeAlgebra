{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exchangealgebra.example/audit-eval/aprime-calls.schema.json",
  "title": "EA-Gate postings and catalog calls",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "postings",
    "calls"
  ],
  "anyOf": [
    {
      "properties": {
        "postings": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "calls": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "decision"
      ],
      "properties": {
        "decision": {
          "minProperties": 1
        }
      }
    },
    {
      "required": [
        "findings"
      ],
      "properties": {
        "findings": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "conditional"
      ]
    }
  ],
  "properties": {
    "postings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/posting"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "calls": {
      "type": "array",
      "description": "Ordered program. The loader executes calls from index 0 upward and enforces adjustment-before-closing staging.",
      "items": {
        "$ref": "#/$defs/catalogCall"
      }
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "conditional": {
      "$ref": "#/$defs/conditional"
    }
  },
  "$defs": {
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonNegativeAmount": {
      "type": "number",
      "minimum": 0
    },
    "account": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Za-z0-9]*$",
      "description": "Exact AccountTitles constructor name; the loader still resolves it against the registry."
    },
    "emptyParams": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "posting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "txid",
        "side",
        "account",
        "amount"
      ],
      "properties": {
        "txid": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "debit",
            "credit"
          ]
        },
        "account": {
          "$ref": "#/$defs/account"
        },
        "amount": {
          "$ref": "#/$defs/amount"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "amount"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "$ref": "#/$defs/amount"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "locus",
        "detail"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "locus": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conditional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "ifTrue",
        "otherwise"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "ifTrue": {
          "type": "string",
          "minLength": 1
        },
        "otherwise": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "catalogCall": {
      "oneOf": [
        {
          "$ref": "#/$defs/cogsAdjustmentEntries"
        },
        {
          "$ref": "#/$defs/depreciationIndirectEntry"
        },
        {
          "$ref": "#/$defs/depreciationDirectEntry"
        },
        {
          "$ref": "#/$defs/allowanceReplenishmentEntry"
        },
        {
          "$ref": "#/$defs/allowanceResetEntries"
        },
        {
          "$ref": "#/$defs/prepaidExpenseEntry"
        },
        {
          "$ref": "#/$defs/unearnedRevenueEntry"
        },
        {
          "$ref": "#/$defs/accruedRevenueEntry"
        },
        {
          "$ref": "#/$defs/accruedExpenseEntry"
        },
        {
          "$ref": "#/$defs/reversingEntry"
        },
        {
          "$ref": "#/$defs/consumptionTaxSettlementEntry"
        },
        {
          "$ref": "#/$defs/corporateTaxInterimEntry"
        },
        {
          "$ref": "#/$defs/corporateTaxSettlementEntries"
        },
        {
          "$ref": "#/$defs/equityMethodEarningsEntry"
        },
        {
          "$ref": "#/$defs/equityMethodDividendEntry"
        },
        {
          "$ref": "#/$defs/equityMethodEntries"
        },
        {
          "$ref": "#/$defs/equityMethodBalance"
        },
        {
          "$ref": "#/$defs/priorPeriodErrorCorrection"
        },
        {
          "$ref": "#/$defs/finalStockTransfer"
        },
        {
          "$ref": "#/$defs/straightLineDepreciation"
        },
        {
          "$ref": "#/$defs/consolidateInternalTransactions"
        }
      ]
    },
    "cogsAdjustmentEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "cogsAdjustmentEntries"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "beginningInventory",
            "endingInventory"
          ],
          "properties": {
            "beginningInventory": {
              "$ref": "#/$defs/nonNegativeAmount"
            },
            "endingInventory": {
              "$ref": "#/$defs/nonNegativeAmount"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "depreciationIndirectEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "depreciationIndirectEntry"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount"
          ],
          "properties": {
            "amount": {
              "$ref": "#/$defs/amount"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "depreciationDirectEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "depreciationDirectEntry"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "asset"
          ],
          "properties": {
            "amount": {
              "$ref": "#/$defs/amount"
            },
            "asset": {
              "$ref": "#/$defs/account"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allowanceReplenishmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "allowanceReplenishmentEntry"
        },
        "params": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "estimate",
                "current"
              ],
              "properties": {
                "estimate": {
                  "$ref": "#/$defs/nonNegativeAmount"
                },
                "current": {
                  "$ref": "#/$defs/nonNegativeAmount"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rate_basis_points"
              ],
              "properties": {
                "rate_basis_points": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            }
          ]
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allowanceResetEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "allowanceResetEntries"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estimate",
            "current"
          ],
          "properties": {
            "estimate": {
              "$ref": "#/$defs/nonNegativeAmount"
            },
            "current": {
              "$ref": "#/$defs/nonNegativeAmount"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prepaidExpenseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "prepaidExpenseEntry"
        },
        "params": {
          "oneOf": [
            {
              "$ref": "#/$defs/amountAndExpense"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "payment_total",
                "coverage_months",
                "next_period_months",
                "expenseAccount"
              ],
              "properties": {
                "payment_total": {
                  "$ref": "#/$defs/amount"
                },
                "coverage_months": {
                  "type": "integer",
                  "minimum": 1
                },
                "next_period_months": {
                  "type": "integer",
                  "minimum": 1
                },
                "expenseAccount": {
                  "$ref": "#/$defs/account"
                }
              }
            }
          ]
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unearnedRevenueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "unearnedRevenueEntry"
        },
        "params": {
          "$ref": "#/$defs/amountAndRevenue"
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accruedRevenueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "accruedRevenueEntry"
        },
        "params": {
          "$ref": "#/$defs/amountAndRevenue"
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accruedExpenseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "accruedExpenseEntry"
        },
        "params": {
          "oneOf": [
            {
              "$ref": "#/$defs/amountAndExpense"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "principal",
                "annual_rate_basis_points",
                "accrued_months",
                "months_per_year",
                "expenseAccount"
              ],
              "properties": {
                "principal": {
                  "$ref": "#/$defs/amount"
                },
                "annual_rate_basis_points": {
                  "$ref": "#/$defs/nonNegativeAmount"
                },
                "accrued_months": {
                  "type": "integer",
                  "minimum": 1
                },
                "months_per_year": {
                  "type": "integer",
                  "minimum": 1
                },
                "expenseAccount": {
                  "$ref": "#/$defs/account"
                }
              }
            }
          ]
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "amountAndExpense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "expenseAccount"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "expenseAccount": {
          "$ref": "#/$defs/account"
        }
      }
    },
    "amountAndRevenue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "revenueAccount"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "revenueAccount": {
          "$ref": "#/$defs/account"
        }
      }
    },
    "reversingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "reversingEntry"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceTxid"
          ],
          "properties": {
            "sourceTxid": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "consumptionTaxSettlementEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "consumptionTaxSettlementEntry"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paid",
            "received"
          ],
          "properties": {
            "paid": {
              "$ref": "#/$defs/nonNegativeAmount"
            },
            "received": {
              "$ref": "#/$defs/nonNegativeAmount"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "corporateTaxInterimEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "corporateTaxInterimEntry"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount"
          ],
          "properties": {
            "amount": {
              "$ref": "#/$defs/amount"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "corporateTaxSettlementEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "corporateTaxSettlementEntries"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "interim"
          ],
          "properties": {
            "total": {
              "$ref": "#/$defs/nonNegativeAmount"
            },
            "interim": {
              "$ref": "#/$defs/nonNegativeAmount"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "equityMethodEarningsEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "equityMethodEarningsEntry"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "share"
          ],
          "properties": {
            "share": {
              "$ref": "#/$defs/nonNegativeAmount"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "equityMethodDividendEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "equityMethodDividendEntry"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dividend"
          ],
          "properties": {
            "dividend": {
              "$ref": "#/$defs/nonNegativeAmount"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "equityMethodEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "equityMethodEntries"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "share",
            "dividend"
          ],
          "properties": {
            "share": {
              "$ref": "#/$defs/nonNegativeAmount"
            },
            "dividend": {
              "$ref": "#/$defs/nonNegativeAmount"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "equityMethodBalance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "equityMethodBalance"
        },
        "params": {
          "$ref": "#/$defs/emptyParams"
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "priorPeriodErrorCorrection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "priorPeriodErrorCorrection"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "prior",
            "expenseAccount",
            "assetAccount"
          ],
          "properties": {
            "current": {
              "$ref": "#/$defs/nonNegativeAmount"
            },
            "prior": {
              "$ref": "#/$defs/nonNegativeAmount"
            },
            "expenseAccount": {
              "$ref": "#/$defs/account"
            },
            "assetAccount": {
              "$ref": "#/$defs/account"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finalStockTransfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "finalStockTransfer"
        },
        "params": {
          "$ref": "#/$defs/emptyParams"
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "straightLineDepreciation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "straightLineDepreciation"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset",
            "cost",
            "salvage",
            "years",
            "period"
          ],
          "properties": {
            "asset": {
              "$ref": "#/$defs/account"
            },
            "cost": {
              "$ref": "#/$defs/amount"
            },
            "salvage": {
              "$ref": "#/$defs/nonNegativeAmount"
            },
            "years": {
              "type": "integer",
              "minimum": 1
            },
            "period": {
              "type": "integer",
              "minimum": 1
            },
            "method": {
              "enum": [
                "indirect",
                "direct"
              ],
              "default": "indirect"
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "consolidateInternalTransactions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params"
      ],
      "properties": {
        "name": {
          "const": "consolidateInternalTransactions"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entities",
            "eliminationTxids"
          ],
          "properties": {
            "entities": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entity",
                  "txids"
                ],
                "properties": {
                  "entity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "txids": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "eliminationTxids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "txid": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
