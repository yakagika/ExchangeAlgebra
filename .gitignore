.stack-work/
*~
.DS_Store
dist
dist-*
cabal-dev
*.o
*.hi
*.hie
*.chi
*.chs.h
*.dyn_o
*.dyn_hi
.hpc
.hsenv
.cabal-sandbox/
cabal.sandbox.config
*.prof
*.aux
*.hp
*.eventlog
*.csv
# ...but the CGE benchmark ground truth (results.csv + the comparative-
# statics fixtures shock_resolve.py regenerates) are test assets, tracked:
!examples/optimization/CGE/GAMS/*.csv
!examples/optimization/CGE/GAMS/shocks/*.csv
# LHR standard-CGE calibration fixtures are tracked sentinel-test assets.
!examples/optimization/cge-lite/lhr/*.csv
.stack-work/
cabal.project.local
cabal.project.local~
.HTF/
.example/optimization
.ghc.environment.*
*.bin
.claude/
.codex/
CLAUDE.md
plans/
.stack-local/
agent-notes/

# Example execution outputs (regenerated on each run)
examples/**/result/

# audit-eval generated artifacts (LLM outputs + per-run JSON; keep summary.csv)
examples/audit-eval/arms/
examples/audit-eval/metrics/*.json
# Runner stdout logs (*.log) are transient; the tracked *.jsonl / *.meta.json
# already carry the reproducible record.
examples/audit-eval/metrics/*.log
# The blanket `*.csv` above (profiling artifacts) also swallowed summary.csv, so
# the aggregated results README's git policy declares "committed" were in fact
# untracked. Re-except it, same idiom as the CGE fixtures.
!examples/audit-eval/metrics/summary.csv
# Per-cell records (*.jsonl) and run provenance (*.meta.json) are TRACKED: the
# 2026-07-05 Track S pilot's raw data was lost in a machine migration because it
# was ignored, leaving the paper's headline numbers unreproducible from prose
# alone. ~30KB/cell is cheap insurance. The bulk (arms/, per-run *.json which
# duplicates the jsonl) stays ignored.
!examples/audit-eval/metrics/*.jsonl
!examples/audit-eval/metrics/*.meta.json
examples/audit-eval/tasks-s/
__pycache__/
