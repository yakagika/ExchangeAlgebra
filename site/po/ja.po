msgstr "\"side,account,amount\\ndebit,Cash,2000\\ncredit,Saels,2000\\n\""

#: src/io/input.md:116
msgid "\"CSV title error: \""
msgstr "\"CSV title error: \""

#: src/io/input.md:120 src/io/input.md:124
msgid "\"Jan 28 Cash sale\""
msgstr "\"Jan 28 Cash sale\""

#: src/io/input.md:120
msgid "\"debit\""
msgstr "\"debit\""

#: src/io/input.md:120
msgid "\"Cash\""
msgstr "\"Cash\""

#: src/io/input.md:121
msgid "\"credit\""
msgstr "\"credit\""

#: src/io/input.md:121
msgid "\"Saels\""
msgstr "\"Saels\""

#: src/io/input.md:122
msgid "\"Text certification: \""
msgstr "\"Text certification: \""

#: src/io/input.md:126
msgid "\"Entry balance error: \""
msgstr "\"Entry balance error: \""

#: src/io/input.md:129
msgid ""
"In your project directory, run `stack exec -- ghc -Wall -Werror Main.hs -o "
"input-example`, then run `./input-example`."
msgstr ""
"プロジェクトのディレクトリで `stack exec -- ghc -Wall -Werror Main.hs -o "
"input-example` を実行し, 続けて `./input-example` を実行してください."

#: src/io/input.md:131
msgid ""
"```text\n"
"Parsed term totals (debit, credit): (3200,3200)\n"
"Source differences: []\n"
"Admitted journal totals (debit, credit): (3200,3200)\n"
"Normalized title: \"ar\"\n"
"Account name: Right AccountsReceivable\n"
"CSV title error: Left (UnknownAccount \"Saels\")\n"
