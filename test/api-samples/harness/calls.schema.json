{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exchangealgebra:coffee-shop:harness:2026-09",
  "$comment": "Handwritten sample protocol. Sources: CALLS.md sections and Admission Haddock Untrusted submission. No library-generated JSON schema is assumed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["transactions", "calls"],
  "properties": {
    "transactions": {"type": "array", "items": {"$ref": "#/$defs/transaction"}},
    "calls": {"type": "array", "items": {"$ref": "#/$defs/call"}}
  },
  "$defs": {
    "money": {"type": "number", "minimum": 0},
    "identity": {"type": "string", "minLength": 1},
    "account": {
      "$comment": "AdmissionSpec.admissionVocabulary; allowed supply and protected-account checks remain admission constraints.",
      "enum": [
        "Cash", "Deposits", "AccountsReceivable", "MerchandiseInventory", "PrepaidExpenses",
        "Machinery", "AccruedExpenses", "AccumulatedDepreciation", "AllowanceForDoubtfulAccounts",
        "CapitalStock", "RetainedEarnings", "RentExpense", "Sales", "ServiceRevenue",
        "WageExpenditure", "UtilitiesExpense", "SalesCost", "CommunicationExpenses",
        "InventoryShrinkageLoss", "Depreciation", "ProvisionForDoubtfulAccounts",
        "ReversalOfAllowanceForDoubtfulAccounts", "NetIncome", "NetLoss"
      ]
    },
    "posting": {
      "$comment": "IO.Input.Admission.RawPostings and IO.Input.checkedEntryTextIn. Exact numeric representation limits are described in CALLS.md and Value.moneyDecimalFromScientific.",
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "account", "amount"],
      "properties": {
        "side": {"enum": ["Debit", "Credit"]},
        "account": {"$ref": "#/$defs/account"},
        "amount": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "transaction": {
      "$comment": "Submission.submissionPostings. Membership, coverage, duplicates, supply routes, and balance are checked by admit, not uniqueItems.",
      "type": "object",
      "additionalProperties": false,
      "required": ["txid", "postings"],
      "properties": {
        "txid": {"$ref": "#/$defs/identity"},
        "postings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/posting"}}
      }
    },
    "call": {
      "$comment": "CatalogCall subset and Call. AccruedExpense is this protocol's spelling for AccruedExpenseCall. Stage order and registry authorization are admit constraints.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "txid", "operation", "amount"],
          "properties": {
            "id": {"$ref": "#/$defs/identity"},
            "txid": {"$ref": "#/$defs/identity"},
            "operation": {"const": "DepIndirect"},
            "amount": {"$ref": "#/$defs/money"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "txid", "operation", "amount", "account"],
          "properties": {
            "id": {"$ref": "#/$defs/identity"},
            "txid": {"$ref": "#/$defs/identity"},
            "operation": {"const": "AccruedExpense"},
            "amount": {"$ref": "#/$defs/money"},
            "account": {"$ref": "#/$defs/account"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "txid", "operation", "estimate", "current"],
          "properties": {
            "id": {"$ref": "#/$defs/identity"},
            "txid": {"$ref": "#/$defs/identity"},
            "operation": {"const": "Allowance"},
            "estimate": {"$ref": "#/$defs/money"},
            "current": {"$ref": "#/$defs/money"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "txid", "operation"],
          "properties": {
            "id": {"$ref": "#/$defs/identity"},
            "txid": {"$ref": "#/$defs/identity"},
            "operation": {"const": "FinalStock"}
          }
        }
      ]
    }
  }
}
